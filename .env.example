# ============================================
# Stash Mullvad Proxy - Configuration
# ============================================
# Copy this file to .env and customize for your environment

# Mullvad VPN account number (required)
# Find at: https://mullvad.net/en/account
MULLVAD_ACCOUNT=

# Docker network that Stash is on (must already exist)
DOCKER_NETWORK=stash-network

# Web UI port (exposed to host for dashboard access)
WEB_PORT=11000

# Proxy address (internal, accessed by Stash via Docker network)
# No host port mapping needed - Stash reaches it via the shared network
PROXY_ADDR=:11001

# Web UI listen address
WEB_ADDR=:11000

# Persistent data path (stores tunnel configs and routing rules)
DATA_PATH=./data
